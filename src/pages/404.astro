---
import MainGridLayout from "../layouts/MainGridLayout.astro";
import { url } from "../utils/url-utils";
---
<MainGridLayout title="404">
	<div class="card-base relative overflow-hidden p-10 md:p-16 text-center onload-animation">
		<div class="absolute pointer-events-none -top-20 -left-20 w-64 h-64 rounded-full opacity-60"
		     style="background: radial-gradient(closest-side, var(--sakura-soft), transparent)"></div>
		<div class="absolute pointer-events-none -bottom-24 -right-16 w-72 h-72 rounded-full opacity-50"
		     style="background: radial-gradient(closest-side, var(--murasaki-soft), transparent)"></div>

		<div class="relative">
			<div class="text-7xl mb-4">🌸</div>
			<h1 class="text-3xl font-bold text-90 mb-3">啊，迷路了</h1>
			<p class="text-75 mb-1">这片花瓣飘到了没有路的地方。</p>
			<p class="text-50 text-sm mb-8">你要找的页面不存在，或者已经被风吹走了。</p>
			<div class="flex gap-3 justify-center flex-wrap">
				<a href={url('/')} class="btn-regular rounded-full h-11 px-6 font-bold active:scale-95">回首页</a>
				<a href={url('/archive/')} class="btn-plain scale-animation rounded-full h-11 px-6 font-bold border border-[var(--stroke-glass)]">翻翻归档</a>
			</div>
			<p class="text-xs text-50 mt-8">小提示：按 <kbd class="px-1.5 py-0.5 rounded border border-[var(--stroke-glass)]">Ctrl+K</kbd> 可以直接搜索全站哦</p>
		</div>
	</div>
</MainGridLayout>
