---
/**
 * 左侧悬浮导航坞（≥1024px 竖排胶囊，窄屏自动变为顶部横排胶囊）。
 * 纯图标 + 悬停提示；搜索与命令面板共用 Ctrl+K 面板。
 */
import { Icon } from "astro-icon/components";
import { featureConfig, navBarConfig, siteConfig } from "../config";
import { LinkPresets } from "../constants/link-presets";
import { LinkPreset, type NavBarLink } from "../types/config";
import { url } from "../utils/url-utils";
import LightDarkSwitch from "./LightDarkSwitch.svelte";

const className = Astro.props.class;

let links: NavBarLink[] = navBarConfig.links.map(
	(item: NavBarLink | LinkPreset): NavBarLink => {
		if (typeof item === "number") {
			return LinkPresets[item];
		}
		return item;
	},
);

function iconFor(l: NavBarLink): string {
	const u = l.url;
	if (u === "/") return "material-symbols:home-outline-rounded";
	if (u.includes("archive")) return "material-symbols:archive-outline";
	if (u.includes("dashboard")) return "material-symbols:dashboard-outline";
	if (u.includes("photos")) return "material-symbols:photo-library-rounded";
	if (u.includes("about")) return "material-symbols:info-outline-rounded";
	return "fa6-solid:arrow-up-right-from-square";
}
---
<div id="navbar" class="z-50 onload-animation">
    <div class:list={[className, "nav-dock glass-panel flex items-center px-2 py-2 gap-1"]}>
        <a href={url('/')} class="dock-btn btn-plain" aria-label="回到首页" title={siteConfig.title}>
            <Icon name="material-symbols:local-florist-rounded" class="text-[1.55rem] text-[var(--sakura)]" />
        </a>
        <div class="dock-divider" aria-hidden="true"></div>
        {links.map((l) => {
            return <a aria-label={l.name} title={l.name} href={l.external ? l.url : url(l.url)} target={l.external ? "_blank" : null}
                      class="dock-btn btn-plain"
            >
                <Icon name={iconFor(l)} class="text-[1.35rem]" />
                {l.external && <Icon name="fa6-solid:arrow-up-right-from-square" class="absolute translate-x-3 -translate-y-2.5 text-[0.6rem] text-black/30 dark:text-white/30"></Icon>}
            </a>;
        })}
        <div class="dock-divider" aria-hidden="true"></div>
        {featureConfig.commandPalette && (
            <button id="palette-switch" class="dock-btn btn-plain" aria-label="命令面板 (Ctrl+K)" title="命令面板 (Ctrl+K)">
                <Icon name="material-symbols:keyboard-command-key" class="text-[1.3rem]" />
            </button>
        )}
        <LightDarkSwitch client:only="svelte"></LightDarkSwitch>
    </div>
</div>

<script>
function loadButtonScript() {
    let paletteBtn = document.getElementById("palette-switch");
    if (paletteBtn) {
        paletteBtn.onclick = function () {
            window.dispatchEvent(new CustomEvent("fx:open-palette"));
        };
    }
}

loadButtonScript();
</script>
