---
import { Icon } from "astro-icon/components";
import { featureConfig, heroConfig, profileConfig, siteConfig } from "../config";
import { url } from "../utils/url-utils";
import ImageWrapper from "./misc/ImageWrapper.astro";

const { greeting } = heroConfig;
---
<div class="card-base relative overflow-hidden mb-4 onload-animation" id="hero-card">
    <!-- 极光 blob：缓慢漂移呼吸（Banner 已带渐变装饰，此处弱化避免重复） -->
    <div class="hero-blob -top-24 -right-24 w-72 h-72 opacity-40"></div>
    <div class="hero-blob violet -bottom-28 -left-16 w-80 h-80 opacity-35"></div>

    <div class="relative flex flex-col md:flex-row items-center gap-6 md:gap-8 px-6 md:px-10 py-8 md:py-9">
        <a href={url('/about/')} class="shrink-0 relative group" aria-label="关于我">
            <div class="absolute inset-0 rounded-full blur-lg opacity-50 group-hover:opacity-90 transition"
                 style="background: linear-gradient(135deg, var(--sakura), var(--murasaki))"></div>
            <ImageWrapper src={profileConfig.avatar || ""} alt="作者头像"
                          class="relative w-28 h-28 md:w-32 md:h-32 rounded-full object-cover border-4 border-white/70 dark:border-white/10 transition group-hover:scale-105">
            </ImageWrapper>
        </a>

        <div class="flex-1 text-center md:text-left">
            <div class="text-[var(--sakura)] font-bold mb-1.5 tracking-wide">{greeting}</div>
            <h1 class="text-3xl md:text-4xl font-bold mb-2"><span class="gradient-text">{siteConfig.title}</span></h1>
            <p class="text-lg text-75 mb-4 h-8">
                <span id="typewriter-text"></span><span id="typewriter-cursor" class="text-[var(--sakura)] animate-pulse">▏</span>
            </p>
            <div class="flex flex-wrap gap-2 justify-center md:justify-start">
                {profileConfig.links.map((item) => (
                    <a rel="me" aria-label={item.name} href={item.url} target="_blank"
                       class="btn-regular rounded-full h-10 w-10 active:scale-90">
                        <Icon name={item.icon} class="text-[1.4rem]"></Icon>
                    </a>
                ))}
            </div>
        </div>
    </div>
</div>

{featureConfig.typewriter && (
    <script>
        // 打字机：由 src/effects/typewriter.ts 驱动（兼容 swup 重挂载）
        import "../effects/typewriter";
    </script>
)}
