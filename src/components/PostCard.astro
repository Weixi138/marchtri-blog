---
import type { CollectionEntry } from "astro:content";
import path from "node:path";
import { Icon } from "astro-icon/components";
import I18nKey from "../i18n/i18nKey";
import { i18n } from "../i18n/translation";
import { formatDateToYYYYMMDD } from "../utils/date-utils";
import { getCategoryUrl, getDir, getTagUrl } from "../utils/url-utils";
import ImageWrapper from "./misc/ImageWrapper.astro";

interface Props {
	class?: string;
	entry: CollectionEntry<"posts">;
	title: string;
	url: string;
	published: Date;
	updated?: Date;
	tags: string[];
	category: string | null;
	image: string;
	description: string;
	draft: boolean;
	style: string;
}
const {
	entry,
	title,
	url,
	published,
	tags,
	category,
	image,
	description,
	style,
} = Astro.props;
const className = Astro.props.class;

const hasCover = image !== undefined && image !== null && image !== "";

const { remarkPluginFrontmatter } = await entry.render();
---
<!-- 拉伸链接模式：卡片整体可点，内部分类/标签链接置于其上（HTML 不允许嵌套 <a>） -->
<article class:list={["card-base glass-hover-lift group relative overflow-hidden rounded-[var(--radius-card)] w-full", className]} style={style}>
    <a href={url} class="absolute inset-0 z-10" aria-label={title}></a>

    <div class="flex flex-col-reverse md:flex-row md:items-stretch">
        <!-- 文本区 -->
        <div class="flex-1 min-w-0 px-5 md:px-7 pt-5 md:pt-6 pb-5 md:pb-6 flex flex-col">
            <!-- 分类 badge + 日期 -->
            <div class="relative z-20 flex items-center gap-2.5 mb-2.5 w-fit">
                <a href={getCategoryUrl(category)}
                   class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium bg-[var(--sakura-soft)] text-[var(--sakura-deep)] dark:text-[var(--sakura)] transition"
                   aria-label={category || "uncategorized"}>
                    {category || i18n(I18nKey.uncategorized)}
                </a>
                <span class="text-50 text-xs flex items-center gap-1">
                    <Icon name="material-symbols:calendar-today-outline-rounded" class="text-[0.9rem]"></Icon>
                    {formatDateToYYYYMMDD(published)}
                </span>
            </div>

            <!-- 标题 -->
            <h2 class="text-xl md:text-[1.45rem] leading-snug font-bold text-90 mb-2 transition-colors group-hover:text-[var(--sakura-deep)] dark:group-hover:text-[var(--sakura)]">
                {title}
            </h2>

            <!-- 摘要 -->
            <p class="text-sm text-75 leading-relaxed mb-3 line-clamp-2">
                { description || remarkPluginFrontmatter.excerpt }
            </p>

            <!-- 底部：标签 chips + 字数/阅读时长 -->
            <div class="relative z-20 mt-auto flex items-center gap-2 flex-wrap">
                {(tags && tags.length > 0) && tags.slice(0, 3).map((tag) => (
                    <a href={getTagUrl(tag)}
                       class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs bg-[var(--murasaki-soft)] text-[var(--murasaki-deep)] dark:text-[var(--murasaki)] transition hover:brightness-105"
                       aria-label={tag.trim()}>
                        {tag.trim()}
                    </a>
                ))}
                <span class="ml-auto text-xs text-30 flex items-center gap-3 shrink-0">
                    <span class="flex items-center gap-1">
                        <Icon name="material-symbols:edit-note-rounded" class="text-[1rem]"></Icon>
                        {remarkPluginFrontmatter.words} {i18n(remarkPluginFrontmatter.words === 1 ? I18nKey.wordCount : I18nKey.wordsCount)}
                    </span>
                    <span class="flex items-center gap-1">
                        <Icon name="material-symbols:schedule-rounded" class="text-[1rem]"></Icon>
                        {remarkPluginFrontmatter.minutes} {i18n(remarkPluginFrontmatter.minutes === 1 ? I18nKey.minuteCount : I18nKey.minutesCount)}
                    </span>
                </span>
            </div>
        </div>

        <!-- 封面：右侧圆角缩略图（移动端置顶）；无封面用品牌渐变占位 -->
        <div class:list={["relative shrink-0 overflow-hidden", hasCover
            ? "h-44 md:h-auto md:w-[15.5rem] md:self-stretch md:my-3.5 md:mr-3.5 md:rounded-2xl"
            : "h-32 md:h-auto md:w-[9.5rem] md:self-stretch md:my-3.5 md:mr-3.5 md:rounded-2xl"]}>
            {hasCover && <ImageWrapper src={image} basePath={path.join("content/posts/", getDir(entry.id))}
                       alt={`Cover Image of ${title}`}
                       class="w-full h-full transition-transform duration-500 group-hover:scale-[1.04]">
            </ImageWrapper>}
            {!hasCover && <div class="w-full h-full flex items-center justify-center"
                               style="background: linear-gradient(135deg, var(--sakura-soft), var(--murasaki-soft));">
                <Icon name="material-symbols:local-florist-rounded"
                      class="text-5xl text-[var(--sakura)] opacity-60 transition-transform duration-500 group-hover:scale-110 group-hover:rotate-6"></Icon>
            </div>}
        </div>
    </div>
</article>
