---
/**
 * 开屏加载动画（docs/03 P0-5）。
 * 每次整页加载都显示；点击/按键可跳过，资源就绪后提前退场，3.5s 硬上限。
 * 退场由 JS 添加 .fx-loader-out 类触发（0.6s 淡出后移除节点）。
 * 花朵为内联 SVG：花瓣错落开合循环 + 整体缓转 + 花蕊呼吸，全程持续动画。
 */
import { featureConfig, siteConfig } from "../config";

const petals = [0, 72, 144, 216, 288];
---
{featureConfig.loadingScreen && (
	<div id="fx-loader" aria-hidden="true">
		<div class="fx-loader-halo"></div>
		<div class="fx-loader-inner">
			<svg class="fx-loader-flower" viewBox="0 0 120 120">
				<defs>
					<linearGradient id="fxlf-petal" x1="0" y1="0" x2="1" y2="1">
						<stop offset="0" style="stop-color: var(--sakura)" />
						<stop offset="1" style="stop-color: var(--murasaki)" />
					</linearGradient>
					<radialGradient id="fxlf-core" cx="0.4" cy="0.35" r="1">
						<stop offset="0" style="stop-color: color-mix(in srgb, var(--warm) 55%, #ffffff)" />
						<stop offset="1" style="stop-color: var(--warm)" />
					</radialGradient>
				</defs>
				<g class="fxlf-spin">
					{petals.map((deg, i) => (
						<g transform={`rotate(${deg} 60 60)`}>
							<path
								class="fxlf-petal"
								style={`animation-delay:${i * 0.16}s`}
								d="M60 62 C 76 48 78 24 60 12 C 42 24 44 48 60 62 Z"
								fill="url(#fxlf-petal)"
							/>
						</g>
					))}
				</g>
				<circle class="fxlf-core" cx="60" cy="60" r="11" fill="url(#fxlf-core)" />
				<circle class="fxlf-dot" cx="56" cy="55" r="3.4" style="fill: var(--stroke-glass)" />
			</svg>
			<div class="fx-loader-title">{siteConfig.title}</div>
			<div class="fx-loader-bar"><i></i></div>
		</div>
	</div>
	<script is:inline>
		(function () {
			var el = document.getElementById("fx-loader");
			if (!el) return;
			var start = Date.now();
			var MIN_MS = 1200; // 最短展示时长，保证开屏动画完整呈现
			var MAX_MS = 3500; // 3 秒级硬上限
			var reduced = window.matchMedia(
				"(prefers-reduced-motion: reduce)",
			).matches;
			var gone = false;

			function dismiss() {
				if (gone) return;
				gone = true;
				el.classList.add("fx-loader-out");
				window.removeEventListener("pointerdown", skip, true);
				window.removeEventListener("keydown", skip, true);
				// 退场动画结束后移除节点（双保险）
				setTimeout(function () {
					if (el.parentNode) el.parentNode.removeChild(el);
				}, 800);
			}
			function skip() {
				dismiss();
			}

			// 点击 / 按键即可跳过
			window.addEventListener("pointerdown", skip, {
				passive: true,
				capture: true,
			});
			window.addEventListener("keydown", skip, { capture: true });

			// 资源就绪即提前退场；不足最短时长则补齐，reduced-motion 快速放行
			function schedule() {
				var wait = reduced ? 300 : Math.max(MIN_MS - (Date.now() - start), 0);
				setTimeout(dismiss, wait);
			}
			if (document.readyState === "complete") schedule();
			else window.addEventListener("load", schedule);
			setTimeout(dismiss, reduced ? 600 : MAX_MS); // 兜底上限
		})();
	</script>
)}

<style>
	#fx-loader {
		position: fixed;
		inset: 0;
		z-index: 300;
		display: flex;
		align-items: center;
		justify-content: center;
		background:
			radial-gradient(60% 50% at 28% 22%, color-mix(in srgb, var(--sakura) 16%, transparent), transparent 60%),
			radial-gradient(52% 46% at 74% 80%, color-mix(in srgb, var(--murasaki) 18%, transparent), transparent 60%),
			var(--loader-bg);
	}
	#fx-loader.fx-loader-out {
		pointer-events: none;
		animation: fx-loader-out 0.6s ease forwards;
	}
	.fx-loader-halo {
		position: absolute;
		width: min(56vmin, 460px);
		height: min(56vmin, 460px);
		border-radius: 50%;
		background: radial-gradient(
			closest-side,
			color-mix(in srgb, var(--sakura) 16%, transparent),
			transparent 70%
		);
		animation: fx-loader-halo 3s ease-in-out;
	}
	.fx-loader-inner {
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1.2rem;
	}
	.fx-loader-flower {
		width: 104px;
		height: 104px;
		filter: drop-shadow(0 10px 30px color-mix(in srgb, var(--sakura) 50%, transparent));
	}
	.fxlf-spin {
		transform-box: view-box;
		transform-origin: 60px 60px;
		animation: fxlf-rotate 9s linear infinite;
	}
	.fxlf-petal {
		transform-box: view-box;
		transform-origin: 60px 60px;
		animation: fxlf-pulse 1.5s ease-in-out infinite;
	}
	.fxlf-core {
		transform-box: fill-box;
		transform-origin: center;
		animation: fxlf-core-pulse 1.5s ease-in-out infinite;
	}
	.fx-loader-title {
		font-size: 1.6rem;
		font-weight: 700;
		letter-spacing: 0.22em;
		text-indent: 0.22em; /* 抵消末字 spacing，保持视觉居中 */
		background: linear-gradient(120deg, var(--sakura), var(--murasaki));
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
		animation: fx-loader-rise 0.8s ease 0.25s both;
	}
	.fx-loader-bar {
		position: relative;
		width: 230px;
		height: 4px;
		border-radius: 999px;
		background: var(--stroke-glass);
		overflow: hidden;
		animation: fx-loader-rise 0.8s ease 0.45s both;
	}
	.fx-loader-bar i {
		display: block;
		height: 100%;
		width: 100%;
		border-radius: inherit;
		background: linear-gradient(90deg, var(--sakura), var(--murasaki));
		transform-origin: left;
		animation: fx-loader-fill 2.55s cubic-bezier(0.65, 0, 0.35, 1) 0.45s both;
	}
	.fx-loader-bar::after {
		content: "";
		position: absolute;
		inset: 0;
		background: linear-gradient(
			100deg,
			transparent 20%,
			var(--stroke-glass) 50%,
			transparent 80%
		);
		transform: translateX(-100%);
		animation: fx-loader-shimmer 1.4s ease-in-out infinite;
	}
	@keyframes fx-loader-out {
		to {
			opacity: 0;
			visibility: hidden;
		}
	}
	@keyframes fxlf-rotate {
		to {
			transform: rotate(360deg);
		}
	}
	@keyframes fxlf-pulse {
		0%,
		100% {
			transform: scale(1);
			opacity: 0.9;
		}
		50% {
			transform: scale(1.17) rotate(2deg);
			opacity: 1;
		}
	}
	@keyframes fxlf-core-pulse {
		0%,
		100% {
			transform: scale(1);
		}
		50% {
			transform: scale(1.22);
		}
	}
	@keyframes fx-loader-shimmer {
		to {
			transform: translateX(100%);
		}
	}
	@keyframes fx-loader-rise {
		from {
			transform: translateY(10px);
			opacity: 0;
		}
		to {
			transform: none;
			opacity: 1;
		}
	}
	@keyframes fx-loader-fill {
		from {
			transform: scaleX(0);
		}
		to {
			transform: scaleX(1);
		}
	}
	@keyframes fx-loader-halo {
		0% {
			transform: scale(0.6);
			opacity: 0;
		}
		30% {
			transform: scale(1);
			opacity: 1;
		}
		100% {
			transform: scale(1.18);
			opacity: 0.7;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.fx-loader-flower,
		.fxlf-spin,
		.fxlf-petal,
		.fxlf-core,
		.fx-loader-title,
		.fx-loader-bar,
		.fx-loader-halo {
			animation-duration: 0.01s;
			animation-iteration-count: 1;
			animation-fill-mode: forwards;
		}
		.fx-loader-bar i {
			animation: none;
			transform: scaleX(1);
		}
		.fx-loader-bar::after {
			display: none;
		}
		#fx-loader.fx-loader-out {
			animation-duration: 0.01s;
		}
	}
</style>
