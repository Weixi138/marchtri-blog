---
/**
 * 强制 3 秒加载动画（docs/03 P0-5）。
 * 每次整页加载都显示；视觉退场由纯 CSS 动画在 3s 时触发（无 JS 也准时），
 * JS 只负责到点后把节点从 DOM 移除（双保险定时器兜底）。
 */
import { featureConfig, siteConfig } from "../config";
---
{featureConfig.loadingScreen && (
	<div id="fx-loader" aria-hidden="true">
		<div class="fx-loader-halo"></div>
		<div class="fx-loader-inner">
			<img src="/favicon/favicon.svg" alt="" class="fx-loader-flower" />
			<div class="fx-loader-title">{siteConfig.title}</div>
			<div class="fx-loader-bar"><i></i></div>
		</div>
	</div>
	<script is:inline>
		(function () {
			var remove = function () {
				var el = document.getElementById("fx-loader");
				if (el) el.remove();
			};
			if (document.readyState === "complete") {
				setTimeout(remove, 3500);
			} else {
				window.addEventListener("load", function () {
					setTimeout(remove, 3500);
				});
			}
			setTimeout(remove, 4500); // 兜底：load 事件异常时也保证退场
		})();
	</script>
)}

<style>
	#fx-loader {
		position: fixed;
		inset: 0;
		z-index: 300;
		display: flex;
		align-items: center;
		justify-content: center;
		animation: fx-loader-out 0.6s ease 3s forwards;
	}
	:root.dark #fx-loader {
		background:
			radial-gradient(60% 50% at 28% 22%, rgba(236, 111, 159, 0.16), transparent 60%),
			radial-gradient(52% 46% at 74% 80%, rgba(159, 127, 240, 0.18), transparent 60%),
			linear-gradient(160deg, #120e1e, #1b1428 55%, #231a34);
	}
	:root:not(.dark) #fx-loader {
		background:
			radial-gradient(60% 50% at 28% 22%, rgba(236, 111, 159, 0.16), transparent 60%),
			radial-gradient(52% 46% at 74% 80%, rgba(159, 127, 240, 0.15), transparent 60%),
			linear-gradient(160deg, #fdf6f9, #f4eefa);
	}
	.fx-loader-halo {
		position: absolute;
		width: min(52vmin, 420px);
		height: min(52vmin, 420px);
		border-radius: 50%;
		background: radial-gradient(
			closest-side,
			rgba(236, 111, 159, 0.14),
			transparent 70%
		);
		animation: fx-loader-halo 3s ease-in-out;
	}
	.fx-loader-inner {
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1.1rem;
	}
	.fx-loader-flower {
		width: 72px;
		height: 72px;
		animation: fx-loader-bloom 0.9s cubic-bezier(0.34, 1.56, 0.64, 1) both;
		filter: drop-shadow(0 6px 24px rgba(236, 111, 159, 0.45));
	}
	.fx-loader-title {
		font-size: 1.5rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		background: linear-gradient(120deg, var(--sakura), var(--murasaki));
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
		animation: fx-loader-rise 0.8s ease 0.25s both;
	}
	.fx-loader-bar {
		width: 220px;
		height: 3px;
		border-radius: 999px;
		background: var(--stroke-glass);
		overflow: hidden;
		animation: fx-loader-rise 0.8s ease 0.45s both;
	}
	.fx-loader-bar i {
		display: block;
		height: 100%;
		width: 100%;
		border-radius: inherit;
		background: linear-gradient(90deg, var(--sakura), var(--murasaki));
		transform-origin: left;
		animation: fx-loader-fill 2.55s cubic-bezier(0.65, 0, 0.35, 1) 0.45s both;
	}
	@keyframes fx-loader-out {
		to {
			opacity: 0;
			visibility: hidden;
		}
	}
	@keyframes fx-loader-bloom {
		from {
			transform: scale(0.3) rotate(-40deg);
			opacity: 0;
		}
		to {
			transform: scale(1) rotate(0);
			opacity: 1;
		}
	}
	@keyframes fx-loader-rise {
		from {
			transform: translateY(10px);
			opacity: 0;
		}
		to {
			transform: none;
			opacity: 1;
		}
	}
	@keyframes fx-loader-fill {
		from {
			transform: scaleX(0);
		}
		to {
			transform: scaleX(1);
		}
	}
	@keyframes fx-loader-halo {
		0% {
			transform: scale(0.6);
			opacity: 0;
		}
		30% {
			transform: scale(1);
			opacity: 1;
		}
		100% {
			transform: scale(1.18);
			opacity: 0.7;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.fx-loader-flower,
		.fx-loader-title,
		.fx-loader-bar,
		.fx-loader-halo {
			animation-duration: 0.01s;
			animation-fill-mode: forwards;
		}
		.fx-loader-bar i {
			animation: none;
			transform: scaleX(1);
		}
		#fx-loader {
			animation-delay: 3s;
		}
	}
</style>
