---
import { Icon } from "astro-icon/components";
import { profileConfig } from "../../config";
import { url } from "../../utils/url-utils";
import ImageWrapper from "../misc/ImageWrapper.astro";

const config = profileConfig;
---
<div class="card-base p-4">
    <div class="flex items-center gap-3 mb-3">
        <a aria-label="Go to About Page" href={url('/about/')}
           class="group relative shrink-0 w-12 h-12 rounded-full overflow-hidden active:scale-95 transition">
            <ImageWrapper src={config.avatar || ""} alt="Profile Image of the Author" class="w-full h-full"></ImageWrapper>
            <div class="absolute inset-0 transition pointer-events-none group-hover:bg-black/25 rounded-full"></div>
        </a>
        <div class="min-w-0">
            <a href={url('/about/')} class="font-bold text-lg text-90 transition hover:text-[var(--sakura-deep)] dark:hover:text-[var(--sakura)]">{config.name}</a>
            <div class="text-xs text-50 transition">关于我 →</div>
        </div>
    </div>
    <div class="text-sm text-75 leading-relaxed mb-3 transition">{config.bio}</div>
    <div class="flex flex-wrap gap-2">
        {config.links.map(item =>
                <a rel="me" aria-label={item.name} href={item.url} target="_blank"
                   class="btn-plain rounded-lg h-9 w-9 border border-[var(--stroke-glass)] bg-[var(--bg-glass)] active:scale-90 transition">
                    <Icon name={item.icon} class="text-[1.25rem]"></Icon>
                </a>
        )}
    </div>
</div>
