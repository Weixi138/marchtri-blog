---
import { Icon } from "astro-icon/components";
import I18nKey from "../i18n/i18nKey";
import { i18n } from "../i18n/translation";
import { formatDateToYYYYMMDD } from "../utils/date-utils";
import { getCategoryUrl, getTagUrl } from "../utils/url-utils";

interface Props {
	class: string;
	published: Date;
	updated?: Date;
	tags: string[];
	category: string | null;
	hideTagsForMobile?: boolean;
	hideUpdateDate?: boolean;
}
const {
	published,
	updated,
	tags,
	category,
	hideTagsForMobile = false,
	hideUpdateDate = false,
} = Astro.props;
const className = Astro.props.class;
---

<div class:list={["flex flex-wrap items-center gap-x-4 gap-y-2 text-sm", className]}>
    <!-- publish date（明信片邮戳样式，S4 签名细节） -->
    <div class="postmark flex items-center gap-1.5 text-50">
        <Icon name="material-symbols:calendar-today-outline-rounded" class="text-[1.1rem] text-[var(--sakura)]"></Icon>
        <span class="font-medium">{formatDateToYYYYMMDD(published)}</span>
    </div>

    <!-- update date -->
    {!hideUpdateDate && updated && updated.getTime() !== published.getTime() && (
        <div class="flex items-center gap-1.5 text-50">
            <Icon name="material-symbols:edit-calendar-outline-rounded" class="text-[1.1rem] text-[var(--warm)]"></Icon>
            <span class="font-medium">{formatDateToYYYYMMDD(updated)}</span>
        </div>
    )}

    <!-- categories -->
    <a href={getCategoryUrl(category)} aria-label={`View all posts in the ${category} category`}
       class="flex items-center gap-1.5 text-50 transition hover:text-[var(--sakura-deep)] dark:hover:text-[var(--sakura)] whitespace-nowrap">
        <Icon name="material-symbols:book-2-outline-rounded" class="text-[1.1rem] text-[var(--murasaki)]"></Icon>
        <span class="font-medium">{category || i18n(I18nKey.uncategorized)}</span>
    </a>

    <!-- tags -->
    <div class:list={["flex flex-wrap items-center gap-1.5", {"hidden md:flex": hideTagsForMobile}]}>
        {(tags && tags.length > 0) && tags.map((tag) => (
            <a href={getTagUrl(tag)} aria-label={`View all posts with the ${tag.trim()} tag`}
               class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs bg-[var(--murasaki-soft)] text-[var(--murasaki-deep)] dark:text-[var(--murasaki)] transition hover:brightness-105 whitespace-nowrap">
                {tag.trim()}
            </a>
        ))}
        {!(tags && tags.length > 0) && <div class="transition text-50 font-medium">{i18n(I18nKey.noTags)}</div>}
    </div>
</div>

<style>
    .postmark {
        border: 1.5px dashed color-mix(in srgb, var(--sakura) 55%, transparent);
        border-radius: var(--radius-pill);
        padding: 0.12rem 0.65rem;
        transform: rotate(-1.6deg);
        transition: transform 0.25s var(--ease-spring);
    }
    .postmark:hover {
        transform: rotate(0deg) scale(1.03);
    }
    @media (prefers-reduced-motion: reduce) {
        .postmark {
            transform: none;
        }
    }
</style>
