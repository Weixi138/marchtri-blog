---
import BackToTop from "@components/control/BackToTop.astro";
import Footer from "@components/Footer.astro";
import Navbar from "@components/Navbar.astro";
import SideBar from "@components/widget/SideBar.astro";
import type { MarkdownHeading } from "astro";
import { Icon } from "astro-icon/components";
import TOC from "../components/widget/TOC.astro";
import { siteConfig } from "../config";
import {
	BANNER_HEIGHT,
	BANNER_HEIGHT_EXTEND,
	MAIN_PANEL_OVERLAPS_BANNER_HEIGHT,
} from "../constants/constants";
import Layout from "./Layout.astro";

interface Props {
	title?: string;
	banner?: string;
	description?: string;
	lang?: string;
	setOGTypeArticle?: boolean;
	headings?: MarkdownHeading[];
}

const {
	title,
	banner,
	description,
	lang,
	setOGTypeArticle,
	headings = [],
} = Astro.props;
const hasBannerCredit =
	siteConfig.banner.enable && siteConfig.banner.credit.enable;
const hasBannerLink = !!siteConfig.banner.credit.url;

const mainPanelTop = siteConfig.banner.enable
	? `calc(${BANNER_HEIGHT}vh - ${MAIN_PANEL_OVERLAPS_BANNER_HEIGHT}rem)`
	: "5.5rem";
---

<Layout title={title} banner={banner} description={description} lang={lang} setOGTypeArticle={setOGTypeArticle}>

<!-- Navbar：顶部悬浮玻璃条（fixed 样式见 main.css #navbar-wrapper） -->
<slot slot="head" name="head"></slot>
<div id="top-row" class="z-50 pointer-events-none relative max-w-[var(--page-width)] px-0 md:px-4 mx-auto">
    <div id="navbar-wrapper" class="transition-all">
        <Navbar></Navbar>
    </div>
</div>

<!-- Banner：纯 CSS 渐变装饰（叠加在天气天空 canvas 之上，底部渐隐） -->
{siteConfig.banner.enable && <div id="banner-wrapper" class={`absolute z-10 w-full transition duration-700 overflow-hidden`} style={`top: -${BANNER_HEIGHT_EXTEND}vh`}>
    <div id="banner" class="relative w-full h-full transition duration-700 opacity-0 scale-105">
        <div class="banner-blob banner-blob-1" aria-hidden="true"></div>
        <div class="banner-blob banner-blob-2" aria-hidden="true"></div>
        <!-- 四季 Banner（S2）：四幅内联 SVG 常驻，CSS 按 html[data-season] 切换显示，未注入属性时默认春樱 -->
        <svg class="banner-branch banner-season banner-season-spring" viewBox="0 0 420 240" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <defs>
                <g id="banner-sakura">
                    <ellipse cx="0" cy="-11" rx="6.5" ry="12" style="fill: var(--banner-petal)" transform="rotate(0)"></ellipse>
                    <ellipse cx="0" cy="-11" rx="6.5" ry="12" style="fill: var(--banner-petal)" transform="rotate(72)"></ellipse>
                    <ellipse cx="0" cy="-11" rx="6.5" ry="12" style="fill: var(--banner-petal)" transform="rotate(144)"></ellipse>
                    <ellipse cx="0" cy="-11" rx="6.5" ry="12" style="fill: var(--banner-petal)" transform="rotate(216)"></ellipse>
                    <ellipse cx="0" cy="-11" rx="6.5" ry="12" style="fill: var(--banner-petal)" transform="rotate(288)"></ellipse>
                    <circle r="3.2" style="fill: var(--banner-core)"></circle>
                </g>
            </defs>
            <path d="M6 238 C 96 206, 158 178, 214 132 C 254 100, 300 62, 414 30" style="stroke: var(--banner-petal)" stroke-width="3.5" stroke-linecap="round"></path>
            <path d="M214 132 C 236 146, 258 160, 276 182" style="stroke: var(--banner-petal-soft)" stroke-width="2.5" stroke-linecap="round"></path>
            <use href="#banner-sakura" transform="translate(214 132)"></use>
            <use href="#banner-sakura" transform="translate(276 182) scale(0.8) rotate(25)"></use>
            <use href="#banner-sakura" transform="translate(330 62) scale(1.1) rotate(-15)"></use>
            <use href="#banner-sakura" transform="translate(120 196) scale(0.7) rotate(40)"></use>
            <circle cx="252" cy="98" r="4" style="fill: var(--banner-petal-soft)"></circle>
            <circle cx="292" cy="52" r="3" style="fill: var(--banner-petal-soft)"></circle>
            <circle cx="180" cy="160" r="3" style="fill: var(--banner-petal-soft)"></circle>
        </svg>
        <svg class="banner-branch banner-season banner-season-summer" viewBox="0 0 420 240" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M6 238 C 96 206, 158 178, 214 132 C 254 100, 300 62, 414 30" style="stroke: var(--banner-petal)" stroke-width="3.5" stroke-linecap="round"></path>
            <path d="M280 68 C 294 78, 306 90, 314 104" style="stroke: var(--banner-petal-soft)" stroke-width="2.5" stroke-linecap="round"></path>
            <line x1="280" y1="68" x2="280" y2="88" style="stroke: var(--banner-petal-soft)" stroke-width="2" stroke-linecap="round"></line>
            <path d="M256 118 Q256 86 280 86 Q304 86 304 118 Z" style="fill: var(--banner-petal)"></path>
            <line x1="250" y1="118" x2="310" y2="118" style="stroke: var(--banner-petal-soft)" stroke-width="2.5" stroke-linecap="round"></line>
            <line x1="280" y1="118" x2="282" y2="146" style="stroke: var(--banner-petal-soft)" stroke-width="1.5"></line>
            <circle cx="280" cy="124" r="3.2" style="fill: var(--banner-core)"></circle>
            <rect x="274" y="146" width="14" height="42" rx="4" transform="rotate(6 281 146)" style="fill: var(--banner-petal-soft)"></rect>
            <circle cx="230" cy="122" r="3" style="fill: var(--banner-petal-soft)"></circle>
            <circle cx="346" cy="64" r="3" style="fill: var(--banner-petal-soft)"></circle>
            <circle cx="180" cy="160" r="3" style="fill: var(--banner-petal-soft)"></circle>
        </svg>
        <svg class="banner-branch banner-season banner-season-autumn" viewBox="0 0 420 240" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <defs>
                <g id="banner-maple">
                    <path d="M0 -15 C 2.5 -9 4.5 -8 8.5 -10 C 7.5 -5 8.5 -3.5 13 -2.5 C 8.5 0 7.5 2 7.5 6.5 C 3.5 4.5 1.5 5 0 8.5 C -1.5 5 -3.5 4.5 -7.5 6.5 C -7.5 2 -8.5 0 -13 -2.5 C -8.5 -3.5 -7.5 -5 -8.5 -10 C -4.5 -8 -2.5 -9 0 -15 Z" style="fill: var(--banner-petal)"></path>
                    <line x1="0" y1="7" x2="0" y2="14" style="stroke: var(--banner-petal-soft)" stroke-width="1.5" stroke-linecap="round"></line>
                </g>
            </defs>
            <path d="M6 238 C 96 206, 158 178, 214 132 C 254 100, 300 62, 414 30" style="stroke: var(--banner-petal)" stroke-width="3.5" stroke-linecap="round"></path>
            <path d="M214 132 C 236 146, 258 160, 276 182" style="stroke: var(--banner-petal-soft)" stroke-width="2.5" stroke-linecap="round"></path>
            <use href="#banner-maple" transform="translate(214 132) rotate(-10)"></use>
            <use href="#banner-maple" transform="translate(300 84) scale(0.85) rotate(18)"></use>
            <use href="#banner-maple" transform="translate(120 196) scale(0.7) rotate(30)"></use>
            <use href="#banner-maple" transform="translate(352 48) scale(1.05) rotate(-22)"></use>
            <circle cx="252" cy="112" r="3" style="fill: var(--banner-petal-soft)"></circle>
            <circle cx="176" cy="166" r="3" style="fill: var(--banner-petal-soft)"></circle>
        </svg>
        <svg class="banner-branch banner-season banner-season-winter" viewBox="0 0 420 240" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <defs>
                <g id="banner-snow">
                    <line x1="0" y1="-10" x2="0" y2="10" style="stroke: var(--banner-petal-soft)" stroke-width="1.8" stroke-linecap="round"></line>
                    <line x1="0" y1="-10" x2="0" y2="10" style="stroke: var(--banner-petal-soft)" stroke-width="1.8" stroke-linecap="round" transform="rotate(60)"></line>
                    <line x1="0" y1="-10" x2="0" y2="10" style="stroke: var(--banner-petal-soft)" stroke-width="1.8" stroke-linecap="round" transform="rotate(120)"></line>
                    <circle r="2" style="fill: var(--banner-core)"></circle>
                </g>
            </defs>
            <path d="M6 238 C 96 206, 158 178, 214 132 C 254 100, 300 62, 414 30" style="stroke: var(--banner-petal)" stroke-width="3.5" stroke-linecap="round"></path>
            <path d="M214 132 C 236 146, 258 160, 276 182" style="stroke: var(--banner-petal-soft)" stroke-width="2.5" stroke-linecap="round"></path>
            <circle cx="150" cy="180" r="3.5" style="fill: var(--banner-core)"></circle>
            <circle cx="246" cy="112" r="3.5" style="fill: var(--banner-core)"></circle>
            <circle cx="330" cy="62" r="3" style="fill: var(--banner-core)"></circle>
            <use href="#banner-snow" transform="translate(200 140)"></use>
            <use href="#banner-snow" transform="translate(312 70) scale(0.85)"></use>
            <use href="#banner-snow" transform="translate(110 196) scale(0.7)"></use>
            <use href="#banner-snow" transform="translate(368 40) scale(0.75)"></use>
            <circle cx="262" cy="96" r="2.2" style="fill: var(--banner-petal-soft)"></circle>
            <circle cx="180" cy="170" r="2.2" style="fill: var(--banner-petal-soft)"></circle>
            <circle cx="296" cy="150" r="2.2" style="fill: var(--banner-petal-soft)"></circle>
        </svg>
    </div>
</div>}

<!-- Main content -->
<div class="absolute w-full z-30 pointer-events-none" style={`top: ${mainPanelTop}`}>
    <!-- The pointer-events-none here prevent blocking the click event of the TOC -->
    <div class="relative max-w-[var(--page-width)] mx-auto pointer-events-auto">
        <div id="main-grid" class="transition duration-700 w-full left-0 right-0 grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_var(--sidebar-width)] grid-rows-[auto_1fr_auto] lg:grid-rows-[auto]
    mx-auto gap-4 px-0 md:px-4"
        >
            <!-- Banner image credit -->
            {hasBannerCredit && <a href={siteConfig.banner.credit.url} id="banner-credit" target="_blank" rel="noopener" aria-label="Visit image source"
                                   class:list={["group onload-animation transition-all absolute flex justify-center items-center rounded-full " +
                                   "px-3 right-4 -top-[3.25rem] bg-black/60 hover:bg-black/70 h-9", {"hover:pr-9 active:bg-black/80": hasBannerLink}]}
            >
                <Icon class="text-white/75 text-[1.25rem] mr-1" name="material-symbols:copyright-outline-rounded" ></Icon>
                <div class="text-white/75 text-xs">{siteConfig.banner.credit.text}</div>
                <Icon class:list={["transition absolute text-[var(--sakura)] right-4 text-[0.75rem] opacity-0",
                    {"group-hover:opacity-100": hasBannerLink}]}
                      name="fa6-solid:arrow-up-right-from-square">
                </Icon>
            </a>}

            <!-- 主内容在左，侧栏挂件移至右侧（docs/01 版式） -->
            <main id="swup-container" class="transition-swup-fade col-span-1 lg:col-start-1 lg:row-start-1 overflow-hidden">
                <div id="content-wrapper" class="onload-animation">
                    <!-- the overflow-hidden here prevent long text break the layout-->
                    <!-- make id different from windows.swup global property -->
                    <slot></slot>
                </div>
            </main>

            <SideBar class="mb-4 lg:mb-0 col-span-1 lg:col-start-2 lg:row-start-1 lg:max-w-[var(--sidebar-width)] onload-animation" headings={headings}></SideBar>

            <!-- 唯一 Footer：移动端单列，桌面跨主栏+侧栏两列 -->
            <div class="footer col-span-1 lg:col-span-2 lg:row-start-2 onload-animation">
                <Footer></Footer>
            </div>
        </div>

        <BackToTop></BackToTop>
    </div>
</div>

<!-- The things that should be under the banner, only the TOC for now -->
<div class="absolute w-full z-0 hidden 2xl:block">
    <div class="relative max-w-[var(--page-width)] mx-auto">
        <!-- TOC component -->
        {siteConfig.toc.enable && <div id="toc-wrapper" class:list={["hidden lg:block transition absolute top-0 -right-[var(--toc-width)] w-[var(--toc-width)] items-center",
            {"toc-hide": siteConfig.banner.enable}]}
        >
            <div id="toc-inner-wrapper" class="fixed top-[5.5rem] w-[var(--toc-width)] h-[calc(100vh_-_20rem)] overflow-y-scroll overflow-x-hidden hide-scrollbar">
                <div id="toc" class="w-full h-full transition-swup-fade ">
                    <div class="h-8 w-full"></div>
                    <TOC headings={headings}></TOC>
                    <div class="h-8 w-full"></div>
                </div>
            </div>
        </div>}

        <!-- #toc needs to exist for Swup to work normally -->
        {!siteConfig.toc.enable && <div id="toc"></div>}
    </div>
</div>
</Layout>
